{
    "compilerOptions": {
        "declaration": true,
        "module": "node16",
        "moduleResolution": "node16",
        "noImplicitAny": true,
        "alwaysStrict": true,
        "strictBindCallApply": true,
        "strictFunctionTypes": true,
        "noImplicitThis": true,
        "target": "es2020",
        "outDir": "lib",
        "rootDir": "src",
        "preserveConstEnums": true,
        "lib": [
            "es2020",
            "es2020.bigint"
        ],
        "types": [
            "node"
        ],
        "removeComments": false,
        "sourceMap": true,
        "stripInternal": true
    },
    "include": [
        "src/index.ts"
    ]
}
